# OpticWitness frontend configuration (Vite exposed VITE_* vars)
# Copy to .env and configure local values:
#
#   cd frontend
#   cp .env.example .env
#

# Privy application ID (obtained from https://dashboard.privy.io)
VITE_PRIVY_APP_ID=

# Deployed OpticWitness contract address on GenLayer StudioNet (0x...)
VITE_CONTRACT_ADDRESS=
